# Server Port (Railway automatically sets PORT)
PORT=8000

# Session Secret (Optional - fallback is provided if not set)
SHOP_SESSION_SECRET=your_random_secret_key_here

# Database Settings
# On Railway: Adding a MySQL plugin automatically sets MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE, and MYSQL_URL.
# If connecting manually:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=shop_management

# Or single URL format:
# MYSQL_URL=mysql://root:password@host:port/database
